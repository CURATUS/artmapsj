---
import Base from '../layouts/Base.astro';
import { getArtworks, artworkUrl } from '../lib/artworks';
import { categories, categoryOf } from '../data/categories';

const all = await getArtworks();
const missing = all.filter((e) => !e.data.featured);
const done = all.length - missing.length;

const groups = Object.entries(categories)
  .map(([key, c]) => ({ key, ...c, items: missing.filter((e) => categoryOf(e.id) === key) }))
  .filter((g) => g.items.length > 0);
---

<Base title="Photos needed" description="Help photograph San José's public art for ArtMapSJ.">
  <main class="page">
    <a class="back" href="/">← Back to map</a>
    <h2>📷 Photos needed</h2>
    <p>
      Art should be seen, not just listed. We have photos for <strong>{done}</strong> of <strong>{all.length}</strong> pieces
      so far. The ones below still need one.
    </p>
    <p>
      A contributor program is coming soon. Photographers will be able to register once, submit photos, and be credited on the
      map with a link to their Instagram. If you'd like to help before then, keep an eye on this page.
    </p>

    {
      groups.map((g) => (
        <>
          <h3>
            {g.items.length} {g.items.length === 1 ? g.label.toLowerCase() : g.plural}
          </h3>
          <ul class="list">
            {g.items.map((e) => (
              <li>
                <a href={artworkUrl(e)}>{e.data.title}</a>
                {e.data.artist && <span>{e.data.artist}</span>}
              </li>
            ))}
          </ul>
        </>
      ))
    }
  </main>
</Base>
